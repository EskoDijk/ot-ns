#!/bin/bash
# SPDX-License-Identifier: Apache-2.0
#
# Installs an OTNS-compatible entry point for a built zephyr.exe into
# ot-versions/. native_sim executables don't accept OTNS's positional
# <nodeId> <socket> [<seed>] CLI convention directly, so the installed
# file is a thin wrapper that points ZEPHYR_EXE at this build's zephyr.exe
# and execs otns_node_wrapper.sh to do the translation.
#
# Usage: install_exe <builddir-under-./build> <destination-name-under-ot-versions>

set -euo pipefail

ZEPHYR_SRCDIR="$(cd "$(dirname "$0")/.." && pwd)"
BUILDDIR="$1"
DESTNAME="$2"
DEST="${ZEPHYR_SRCDIR}/ot-versions/${DESTNAME}"

mkdir -p "${ZEPHYR_SRCDIR}/ot-versions"

cat >"${DEST}" <<EOF
#!/bin/sh
# SPDX-License-Identifier: Apache-2.0
#
# Generated by zephyr/script/install_exe -- do not edit directly.
ZEPHYR_EXE="${ZEPHYR_SRCDIR}/build/${BUILDDIR}/zephyr/zephyr.exe" exec "${ZEPHYR_SRCDIR}/script/otns_node_wrapper.sh" "\$@"
EOF

chmod +x "${DEST}"
