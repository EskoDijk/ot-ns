# Build script to build an OTBR, to use in OTNS realtime mode.
# It requires a manual setup of the 'ot-br-posix' repository in the same directory where
# the 'ot-ns' directory is, which holds the checked-out repo.

set -euxo pipefail

# OpenThread Border Router (OTBR) options.
OTBR_OPTIONS=(
    "-DBUILD_TESTING=OFF"
    "-DOT_THREAD_VERSION=1.4"
    "-DOT_REFERENCE_DEVICE=OFF"
    "-DOT_LOG_OUTPUT=PLATFORM_DEFINED"
    "-DOT_VENDOR_SW_VERSION=2.0.0"
    "-DOT_OTNS=ON"
    "-DOT_FULL_LOGS=ON"
    "-DOT_LOG_LEVEL=DEBG"
    "-DOT_MLR=ON"
    "-DOT_BORDER_ROUTING=ON"
    "-DOT_BORDER_ROUTING_DHCP6_PD=ON"
    "-DOT_SRP_CLIENT=ON"
    "-DOT_DNS_CLIENT=ON"
    "-DOT_TCP=ON"
    "-DOT_DNS_CLIENT_OVER_TCP=ON"
    "-DOT_PLATFORM_TCP=OFF"
    "-DOT_FIREWALL=OFF"
    "-DOTBR_VENDOR_NAME=OpenThread.io"
    "-DOTBR_PRODUCT_NAME=RFSIM-OTBR-v1.4"
    "-DOTBR_SRP_SERVER_AUTO_ENABLE=ON"
    "-DOTBR_TREL=ON"
    "-DOTBR_NAT64=ON"
    "-DOTBR_DHCP6_PD=ON"
    "-DOTBR_DHCP6_PD_CLIENT=openthread"
    "-DOTBR_DBUS=ON"
    "-DOTBR_FEATURE_FLAGS=OFF"
    "-DOTBR_TELEMETRY_DATA_API=ON"
    "-DOTBR_WEB=ON"
    "-DOTBR_UNSECURE_JOIN=ON"
    "-DOTBR_LINK_METRICS_TELEMETRY=ON"
)
readonly OTBR_OPTIONS

# D-Bus policy that allows otbr-agent, running as root, to own its D-Bus name. Without it, otbr-agent exits after 30 s.
readonly DBUS_POLICY_FILE=../../ot-br-posix/build/otbr/src/agent/otbr-agent.conf
readonly DBUS_POLICY_DIR=/etc/dbus-1/system.d

install_dbus_policy()
{
    local existing

    if [[ ! -f ${DBUS_POLICY_FILE} ]]; then
        echo "No D-Bus policy file was built (OTBR_DBUS=OFF?): skipped D-Bus policy install."
        return
    fi

    # An existing policy that grants ownership of the OTBR D-Bus name is never overwritten.
    existing=$(grep -lsE 'own(_prefix)?="io\.openthread\.BorderRouter' "${DBUS_POLICY_DIR}"/*.conf \
        /usr/share/dbus-1/system.d/*.conf || true)
    if [[ -n ${existing} ]]; then
        echo "D-Bus policy for otbr-agent already in place, not changed: ${existing}"
        return
    fi

    read -rp "Install D-Bus policy for otbr-agent to ${DBUS_POLICY_DIR}? [y/N] " answer || true
    if [[ ${answer} == [Yy] ]]; then
        sudo install -m 0644 "${DBUS_POLICY_FILE}" "${DBUS_POLICY_DIR}"
        echo "Installed D-Bus policy to ${DBUS_POLICY_DIR}"
        sudo systemctl reload dbus || echo "Could not reload D-Bus: restart D-Bus, or reboot, to activate the policy."
    else
        echo "Skipped. To install manually: sudo install -m 0644 ${DBUS_POLICY_FILE} ${DBUS_POLICY_DIR}"
    fi
}

main()
{
    local options=()
    options+=("${OTBR_OPTIONS[@]}" "$@")

    (
        cd ../../ot-br-posix
        ./script/cmake-build "${options[@]}"
    )

    echo "Build of 'otbr-agent' done."

    read -rp "Copy otbr-agent to /usr/local/sbin for use by OTNS? [y/N] " answer || true
    if [[ ${answer} == [Yy] ]]; then
        sudo cp ../../ot-br-posix/build/otbr/src/agent/otbr-agent /usr/local/sbin
        echo "Copied otbr-agent to /usr/local/sbin"
    else
        echo "Skipped. To copy manually: sudo cp ../../ot-br-posix/build/otbr/src/agent/otbr-agent /usr/local/sbin"
    fi

    read -rp "Copy ot-ctl to /usr/local/bin for use by OTNS? [y/N] " answer || true
    if [[ ${answer} == [Yy] ]]; then
        sudo cp ../../ot-br-posix/build/otbr/third_party/openthread/repo/src/posix/ot-ctl /usr/local/bin
        echo "Copied ot-ctl to /usr/local/bin"
    else
        echo "Skipped. To copy manually: sudo cp ../../ot-br-posix/build/otbr/third_party/openthread/repo/src/posix/ot-ctl /usr/local/bin"
    fi

    install_dbus_policy
}

main "$@"
